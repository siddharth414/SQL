class Solution(object):
    def validPath(self, n, edges, source, destination):
        """
        :type n: int
        :type edges: List[List[int]]
        :type source: int
        :type destination: int
        :rtype: bool
        """
        if source == destination:
            return True

        graph = {}
        for i in range(n):
            graph[i] = []
        
        for u,v in edges:
            graph[u].append(v)
            graph[v].append(u)

        visited = set()
        q = deque([source])
        visited.add(source)
        while q:
            x  = q.popleft()
            

            for i in graph[x]:
                if i == destination:
                    return True

                if i not in visited:
                    visited.add(i)
                    q.append(i)
        return False


            

            





        

        
        
