with cte as(
select 
    left(created_at,7) as ym, sum(value) as rev, lag(sum(value)) over() as prev_mon_rev
from sf_transactions
group by left(created_at,7)
)

select ym,  ((rev-prev_mon_rev)/prev_mon_rev)*100 as revenue_diff_pct from cte
